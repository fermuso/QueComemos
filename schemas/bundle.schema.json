{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quecomemos.local/schemas/bundle.schema.json",
  "title": "QuéComemos bundle 1.0.0",
  "type": "object",
  "required": ["schemaVersion", "kind", "appVersion", "synthetic", "family", "recipes", "sources", "chunks", "menus", "pantry", "shopping"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"}, "appVersion": {"const": "0.1.0"},
    "kind": {"enum": ["demo", "backup", "recipes"]}, "synthetic": {"type": "boolean"},
    "family": {"type": "object", "required": ["members", "outsideMeals"], "properties": {"members": {"type": "array", "items": {"$ref": "#/$defs/member"}}, "outsideMeals": {"type": "array", "items": {"$ref": "#/$defs/outsideMeal"}}}},
    "recipes": {"type": "array", "items": {"$ref": "#/$defs/recipe"}},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "chunks": {"type": "array", "items": {"$ref": "#/$defs/chunk"}},
    "menus": {"type": "array", "items": {"type": "object", "required": ["id", "weekStart", "entries"], "properties": {"id": {"$ref": "#/$defs/id"}, "weekStart": {"$ref": "#/$defs/date"}, "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}}}}},
    "pantry": {"type": "array", "items": {"type": "object", "required": ["ingredientId", "quantity", "unit", "state"], "properties": {"ingredientId": {"$ref": "#/$defs/id"}, "quantity": {"type": "number", "minimum": 0}, "unit": {"$ref": "#/$defs/unit"}, "state": {"$ref": "#/$defs/state"}}}},
    "shopping": {"type": "array", "items": {"type": "object", "required": ["key", "checked"], "properties": {"key": {"$ref": "#/$defs/id"}, "checked": {"type": "boolean"}}}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1},
    "date": {"type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "strings": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "unit": {"enum": ["g", "ml", "unidad", "cucharada", "cucharadita"]},
    "state": {"enum": ["seco", "cocido", "fresco"]},
    "nullablePositive": {"anyOf": [{"type": "null"}, {"type": "number", "exclusiveMinimum": 0}]},
    "member": {"type": "object", "required": ["id", "name", "age", "portion", "allergies", "intolerances", "preferences", "availableMinutes"], "properties": {"id": {"$ref": "#/$defs/id"}, "name": {"$ref": "#/$defs/id"}, "age": {"type": "integer", "minimum": 0, "maximum": 130}, "portion": {"$ref": "#/$defs/nullablePositive"}, "allergies": {"$ref": "#/$defs/strings"}, "intolerances": {"$ref": "#/$defs/strings"}, "preferences": {"$ref": "#/$defs/strings"}, "availableMinutes": {"$ref": "#/$defs/nullablePositive"}}},
    "outsideMeal": {"type": "object", "required": ["id", "date", "meal", "memberIds", "groups", "description"], "properties": {"id": {"$ref": "#/$defs/id"}, "date": {"$ref": "#/$defs/date"}, "meal": {"enum": ["comida", "cena"]}, "memberIds": {"$ref": "#/$defs/strings"}, "groups": {"$ref": "#/$defs/strings"}, "description": {"type": "string"}}},
    "ingredient": {"type": "object", "required": ["ingredientId", "name", "quantity", "unit", "state", "allergens", "allergenStatus"], "properties": {"ingredientId": {"$ref": "#/$defs/id"}, "name": {"$ref": "#/$defs/id"}, "quantity": {"$ref": "#/$defs/nullablePositive"}, "unit": {"$ref": "#/$defs/unit"}, "state": {"$ref": "#/$defs/state"}, "allergens": {"$ref": "#/$defs/strings"}, "allergenStatus": {"enum": ["known", "unknown"]}, "originalQuantityText": {"type": "string"}}},
    "recipe": {"type": "object", "required": ["id", "title", "servings", "ingredients", "steps", "minutes", "allergens", "allergenStatus", "groups", "sourceId", "evidenceChunkIds"], "properties": {"id": {"$ref": "#/$defs/id"}, "title": {"$ref": "#/$defs/id"}, "servings": {"type": "number", "exclusiveMinimum": 0}, "ingredients": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ingredient"}}, "steps": {"allOf": [{"$ref": "#/$defs/strings"}, {"minItems": 1}]}, "minutes": {"$ref": "#/$defs/nullablePositive"}, "allergens": {"$ref": "#/$defs/strings"}, "allergenStatus": {"enum": ["known", "unknown"]}, "groups": {"$ref": "#/$defs/strings"}, "sourceId": {"$ref": "#/$defs/id"}, "evidenceChunkIds": {"allOf": [{"$ref": "#/$defs/strings"}, {"minItems": 1}]}}},
    "source": {"type": "object", "required": ["id", "title", "organization", "url", "license", "updated", "accessed", "kind", "attribution"], "properties": {"id": {"$ref": "#/$defs/id"}, "title": {"$ref": "#/$defs/id"}, "organization": {"$ref": "#/$defs/id"}, "url": {"type": "string", "pattern": "^(https?://|local:)"}, "license": {"$ref": "#/$defs/id"}, "updated": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/date"}]}, "accessed": {"$ref": "#/$defs/date"}, "kind": {"enum": ["recipe", "guidance", "user"]}, "attribution": {"$ref": "#/$defs/id"}}},
    "chunk": {"type": "object", "required": ["id", "sourceId", "text", "page", "section"], "properties": {"id": {"$ref": "#/$defs/id"}, "sourceId": {"$ref": "#/$defs/id"}, "text": {"$ref": "#/$defs/id"}, "section": {"$ref": "#/$defs/id"}, "page": {"type": ["integer", "null"], "minimum": 1}, "recipeId": {"$ref": "#/$defs/id"}}},
    "entry": {"type": "object", "required": ["date", "meal", "recipeId", "locked", "evidenceChunkIds", "rationale", "mode"], "properties": {"date": {"$ref": "#/$defs/date"}, "meal": {"enum": ["comida", "cena"]}, "recipeId": {"$ref": "#/$defs/id"}, "locked": {"type": "boolean"}, "evidenceChunkIds": {"allOf": [{"$ref": "#/$defs/strings"}, {"minItems": 1}]}, "rationale": {"type": "string"}, "mode": {"enum": ["demo", "rag", "manual"]}}}
  }
}
